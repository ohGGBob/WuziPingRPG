</aside>
</section>
<dialog id="aiShareDialog" class="ai-dialog"><h2 id="aiShareTitle">天工 · AI 助手对话</h2><canvas id="aiShareCanvas" width="720" height="520"></canvas><div class="ai-dialog-actions"><button id="aiCloseShare" type="button">关闭</button></div></dialog>
<dialog id="aiSessionDialog" class="ai-dialog"><h2 id="aiSessionTitle">会话回放</h2><textarea id="aiSessionText" spellcheck="false"></textarea><div class="ai-dialog-actions"><button id="aiCopy" type="button">复制会话</button><button id="aiLoad" type="button">载入会话文本</button><button id="aiCloseSession" type="button">关闭</button></div></dialog>
<div id="toast" role="status" hidden></div>
<dialog id="anchorDialog"><form method="dialog"><span class="eyebrow">锚点</span><h2>编辑锚点</h2><label for="anchorLabel">标签</label><input id="anchorLabel" autocomplete="off" maxlength="40" placeholder="例如：讲到第 3 页"><label for="anchorTime">时间（秒，可写 1:23）</label><input id="anchorTime" inputmode="decimal" autocomplete="off" placeholder="0.0"><p class="hint" id="anchorSlide">未关联 PPT 照片。</p><div class="dialogactions"><button id="anchorDelete" value="delete">删除</button><button value="cancel">取消</button><button id="anchorSave" value="save" class="primary">保存</button></div></form></dialog>
<dialog id="slideDialog"><form method="dialog"><span class="eyebrow">PPT</span><h2 id="slideTitle">照片预览</h2><img id="slideImage" alt="PPT 照片预览"><div class="dialogactions slidemanage"><button id="slideMoveUp" type="button">← 前移</button><button id="slideMoveDown" type="button">后移 →</button><button id="slideDelete" type="button" class="danger">删除本页</button></div><div class="dialogactions"><button id="slideDemoire" type="button">处理本页摩尔纹</button><button id="slideToggleRaw" type="button" hidden>对比原图</button><button value="cancel">关闭</button><button id="slideSeek" value="seek" class="primary">跳到此页开始</button></div></form></dialog>
<dialog id="menuDialog" class="menu"><div class="menutitle">操作</div><div class="menugrid"><button id="menuMode">回到首页</button><button id="menuNew">新建文件</button><button id="menuTemplates">笔记模板</button><button id="menuSnippets">代码片段</button><button id="menuQuiz">笔记出题</button><button id="menuOpen">打开文件</button><button id="menuFolder">导入文件夹</button><button id="menuSave">保存</button><button id="exportButton">另存为…</button><button id="findButton">查找替换</button><button id="menuSearch">全项目搜索</button><button id="settingsButton">设置</button><button id="menuGame">进入游戏</button></div><form method="dialog"><button class="menuclose">关闭</button></form></dialog>
<dialog id="nameDialog"><form method="dialog"><span class="eyebrow">文件</span><h2 id="nameTitle">新建文件</h2><label for="fileName">文件路径</label><input id="fileName" autocomplete="off" spellcheck="false" placeholder="例如 utils/helper.py"><p class="hint" id="nameHint">可带子文件夹；请写扩展名，例如 .py。</p><div class="dialogactions"><button value="cancel">取消</button><button id="confirmName" value="default" class="primary">创建</button></div></form></dialog>
<dialog id="settingsDialog"><form method="dialog"><span class="eyebrow">工作台</span><h2>设置</h2><fieldset class="theme-field"><legend>外观</legend><div class="theme-choices" id="themeAppearance" role="group" aria-label="外观"><button type="button" data-value="system">跟随系统</button><button type="button" data-value="light">浅色</button><button type="button" data-value="dark">深色</button></div></fieldset><fieldset class="theme-field"><legend>主题色</legend><div class="theme-choices" id="themeAccent" role="group" aria-label="主题色"><button type="button" data-value="teal"><i class="theme-swatch" aria-hidden="true"></i>青绿</button><button type="button" data-value="amber"><i class="theme-swatch" aria-hidden="true"></i>琥珀</button><button type="button" data-value="ink"><i class="theme-swatch" aria-hidden="true"></i>墨蓝</button><button type="button" data-value="rose"><i class="theme-swatch" aria-hidden="true"></i>胭脂</button></div></fieldset><div class="setrow"><label for="fontSize">字号</label><input id="fontSize" type="range" min="12" max="24" value="15"><output id="fontSizeValue">15</output></div><label class="check"><input id="wordWrap" type="checkbox"> 长行自动换行</label><div class="setrow"><label for="timeLimit">运行上限</label><select id="timeLimit"><option value="15">15 秒</option><option value="30">30 秒</option><option value="60">60 秒</option></select></div><p class="hint">外观和主题色保存在这台设备上，重新打开仍然生效，并会写入工作区草稿。Python 和 C/C++ 都在手机本地运行，不联网；C++ 首次运行要加载编译器，稍等几秒。Java 目前只能编辑。</p><div class="dialogactions"><button class="primary">完成</button></div></form></dialog>
<dialog id="templateDialog" class="template-dialog" aria-labelledby="templateTitle">
 <div class="template-head"><span class="eyebrow">笔记</span><h2 id="templateTitle">笔记模板</h2><p>选择模板后新建一篇，或插入到当前笔记。文件名冲突会自动编号。</p></div>
 <div id="templateList" class="template-list" role="radiogroup" aria-label="选择笔记模板"></div>
 <p id="templateHint" class="hint"></p>
 <div class="dialogactions template-actions"><button id="templateCancel" type="button">取消</button><button id="templateInsert" type="button">插入当前笔记</button><button id="templateCreate" type="button" class="primary">新建模板笔记</button></div>
</dialog>
<dialog id="snippetDialog" class="template-dialog" aria-labelledby="snippetTitle">
 <div class="template-head"><span class="eyebrow">代码</span><h2 id="snippetTitle">代码片段</h2><p id="snippetLead">按当前文件语言列出常用模板，点一下插到光标处。</p></div>
 <div id="snippetList" class="snippet-list" aria-label="代码片段列表"></div>
 <div class="dialogactions template-actions"><button id="snippetClose" type="button" class="primary">关闭</button></div>
</dialog>
<dialog id="searchDialog" class="template-dialog" aria-labelledby="searchTitle">
 <div class="template-head"><span class="eyebrow">搜索</span><h2 id="searchTitle">全项目搜索</h2></div>
 <div class="search-bar"><input id="searchInput" type="search" autocomplete="off" spellcheck="false" placeholder="在所有文件里查找…" aria-label="搜索关键词"><label class="search-case"><input id="searchCase" type="checkbox">区分大小写</label></div>
 <p id="searchMeta" class="hint"></p>
 <div id="searchResults" class="search-results" aria-label="搜索结果"></div>
 <div class="dialogactions template-actions"><button id="searchClose" type="button" class="primary">关闭</button></div>
</dialog>
<dialog id="quizDialog" class="quiz-dialog" aria-labelledby="quizTitle">
 <header class="quiz-head"><div><span class="eyebrow">笔记</span><h2 id="quizTitle">生成练习题</h2></div><button id="quizClose" class="quiz-close" type="button" aria-label="关闭">✕</button></header>
 <div class="quiz-scroll">
  <div id="quizSetup" class="quiz-setup">
   <p id="quizNoteInfo" class="quiz-noteinfo"></p>
   <div class="quiz-setrow"><label for="quizCount">题数</label><select id="quizCount"><option value="5">5 题</option><option value="10">10 题</option></select></div>
   <div id="quizPrivacy" class="quiz-privacy">点「AI 生成」才会把这篇笔记发给你配置的接口，中途取消就停。选离线练习的话，全程不出这台手机。</div>
   <p id="quizHint" class="quiz-hint"></p>
   <div class="quiz-actions"><button id="quizOffline" type="button">离线练习（不发送）</button><button id="quizAi" type="button" class="primary">AI 生成（发送笔记）</button></div>
  </div>
  <div id="quizProgress" class="quiz-progress" role="status" hidden><span id="quizProgressText">正在生成…</span><button id="quizCancel" type="button">取消生成</button></div>
  <div id="quizBody" hidden>
   <div class="quiz-meta"><strong id="quizMetaTitle">笔记练习</strong><span id="quizSource" class="quiz-source offline">离线基础练习</span></div>
   <div id="quizQuestions" class="quiz-questions"></div>
   <div id="quizResult" class="quiz-result" role="status" hidden></div>
   <div class="quiz-actions quiz-footer"><button id="quizRegenerate" type="button">重新生成</button><button id="quizRetry" type="button" hidden>重做错题</button><button id="quizSubmit" type="button" class="primary">提交判分</button><button id="quizSave" type="button" class="primary" hidden>保存练习</button></div>
  </div>
 </div>
</dialog>
<input id="browserFiles" type="file" multiple hidden><input id="browserFolder" type="file" multiple webkitdirectory hidden><input id="slideInput" type="file" accept="image/*" multiple hidden><input id="pptxInput" type="file" accept=".pptx,.ppt,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint" hidden>
<script src="sky-ripple.js"></script><script src="boot.js"></script><script src="app.js"></script></body></html>
