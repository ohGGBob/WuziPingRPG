<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content"><meta name="theme-color" content="#ffffff"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232563eb'/%3E%3Cpath d='M8 23V9h4v5.4L17.2 9h5.2l-5.8 6.1L23 23h-5.2l-3.7-5.4L12 19.4V23z' fill='white'/%3E%3C/svg%3E"><meta http-equiv="Content-Security-Policy" content="default-src 'self' data: blob:; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'"><title>天工</title><link rel="stylesheet" href="style.css"><link rel="stylesheet" href="lecture.css"><link rel="stylesheet" href="tts.css"><link rel="stylesheet" href="ai.css"></head>
<body>
<section id="landing" class="home" aria-label="天工首页" data-ready="0">
<header class="home-top">
 <div class="home-brand" id="homeBrand"><span class="brandspark" aria-hidden="true">✦</span><div><strong>天工</strong><span class="brandsub">随身工作台</span></div><span class="brandver">0.1.17</span></div>
 <button id="landingBack" class="home-return" type="button" hidden>返回刚才的工作</button>
</header>
<div class="home-scroll" id="homeScroll">
 <p class="home-status"><span class="status-dot" aria-hidden="true"></span><span id="landingStatus">正在读取草稿</span></p>
 <h1 id="homeTitle">今天从这里开始</h1>
 <p class="home-lead">点一下就进入。返回键先回到这个首页，再按一次才会问你要不要退出。</p>
 <button id="resumeCard" class="home-resume" type="button" hidden disabled>
  <span class="home-kicker">接着做</span>
  <strong id="resumeTitle">继续写 Python</strong>
  <small id="resumeDetail">草稿留在本机</small>
 </button>
 <section class="home-group" aria-label="常用">
  <h2>常用</h2>
  <div class="home-grid">
   <button class="home-card" type="button" data-mode="python" disabled><span class="home-icon" aria-hidden="true">&lt;/&gt;</span><span class="home-copy"><strong>写 Python</strong><small>离线运行代码和项目文件</small></span></button>
   <button class="home-card" type="button" data-mode="notepad" disabled><span class="home-icon" aria-hidden="true">✎</span><span class="home-copy"><strong>记事本</strong><small>写字，草稿自动留在本机</small></span></button>
   <button class="home-card" type="button" data-mode="ai" disabled><span class="home-icon" aria-hidden="true">✧</span><span class="home-copy"><strong>AI 助手</strong><small>对话和手机工具，敏感操作要你点允许</small></span></button>
  </div>
 </section>
 <section class="home-group" aria-label="其他">
  <h2>其他</h2>
  <div class="home-list">
   <button class="home-card home-row" type="button" data-mode="lecture" disabled><span class="home-icon" aria-hidden="true">🎙</span><span class="home-copy"><strong>上课</strong><small>录音、笔记和时间轴</small></span></button>
   <button class="home-card home-row" type="button" data-mode="tts" disabled><span class="home-icon" aria-hidden="true">EN</span><span class="home-copy"><strong>英文朗读</strong><small>按句子朗读英文</small></span></button>
   <button class="home-card home-row" type="button" data-mode="game" disabled><span class="home-icon" aria-hidden="true">✦</span><span class="home-copy"><strong>星火远征</strong><small>原来的游戏存档还在</small></span></button>
  </div>
 </section>
 <p class="home-foot">草稿自动留在本机。要写回手机上的原文件，进到文件里点「保存」。</p>
</div>
</section>
<header class="appbar"><button id="filesToggle" class="icon" aria-label="文件列表" title="文件列表">☰</button><div class="doc"><strong id="activePath">main.py</strong><small id="dirtyFlag">本地草稿</small></div><button id="drawToggle" class="icon drawtoggle" aria-label="画画" title="画画" aria-pressed="false" hidden>🖌️</button><button id="saveButton" class="icon saveicon" aria-label="保存" title="保存">保存</button><button id="homeButton" class="textbtn" type="button" aria-label="回到首页" title="回到首页">首页</button><button id="runButton" class="primary">▶ 运行</button><button id="stopButton" class="danger" hidden>■ 停止</button><button id="moreButton" class="icon" aria-label="更多操作" title="更多操作">⋯</button></header>
<section id="lectureBar" aria-label="上课录音控制" data-state="idle"><span class="recdot" aria-hidden="true"></span><button id="recordBtn" data-role="rec"><span id="recordLabel">🎙 开始录音</span></button><button id="pauseBtn" class="recalt" hidden>⏸ 暂停</button><button id="stopBtn" class="recstop" hidden>⏹ 停止</button><button id="newRecBtn" class="recalt" hidden>🎙 新录音</button><strong id="recordTimer">00:00</strong><label class="rec-translate" id="translateToggle"><input type="checkbox" id="translateCheck"><span class="reccheck"></span><span class="reclabel">翻译</span></label><span class="grow"></span><button id="anchorBtn" class="recanchor" hidden>📌<span class="anchorbtntext"> 标记锚点</span></button></section>
<section id="ttsBar" aria-label="英文朗读控制" data-state="idle">
<div class="tts-main"><span class="tts-mark" aria-hidden="true">EN</span><div class="tts-summary"><strong>英文朗读</strong><small id="ttsMeta" aria-live="off">在编辑器里输入或打开英文文本</small></div><button id="ttsPlay" class="tts-play" aria-label="开始英语朗读"><span id="ttsPlayText">朗读</span></button><button id="ttsStop" class="tts-stop" aria-label="停止英语朗读" title="停止">■</button></div>
<div class="tts-options"><label class="tts-field"><span>语音</span><select id="ttsVoice" aria-label="英语语音"><option value="">系统默认 · English</option></select></label><label class="tts-field tts-rate-field"><span>语速</span><input id="ttsRate" type="range" min="0.75" max="1.5" step="0.05" value="1" aria-label="英语朗读语速"><output id="ttsRateValue">1x</output></label><span id="ttsStatus" role="status">正在准备英语语音…</span><div class="tts-progress" role="progressbar" aria-live="off" aria-label="朗读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="ttsProgressFill"></span></div></div>
</section>
<p id="lectureHint" class="lecturehint" role="status" hidden></p>
<div class="tabbar"><div id="tabs" role="tablist" aria-label="打开的文件"></div><button id="newTab" class="icon tabnew" aria-label="新建文件" title="新建文件">＋</button><button id="gameTab" class="gamepitch">游戏</button></div>
<section id="workbench">
<div id="backdrop" hidden></div><aside id="explorer" aria-label="工作区文件"><div class="sheethead"><strong>文件</strong><button id="closeExplorer" class="icon" aria-label="关闭文件列表">✕</button></div><div class="fileactions"><button id="openFile">打开文件</button><button id="openFolder">导入文件夹</button></div><div id="fileList"></div><div class="explorerfoot">编辑自动保存草稿<br>“保存”写回手机原文件</div><div class="sheetfoot"><button id="newFile" class="newfile">＋ 新建文件</button></div></aside>
<main class="workspace"><div id="editor" aria-label="代码编辑器"><div id="noteEmpty" aria-hidden="true">从这里开始写点什么…</div></div>
<div id="drawLayer" hidden>
  <canvas id="drawCanvas" aria-label="画画画布"></canvas>
  <p id="drawHint">画画模式 · 手指涂写，双指捏合或滚轮缩放</p>
  <div id="drawToolbar">
    <button class="draw-tool active" data-tool="pen" title="画笔">✏️</button>
    <button class="draw-tool" data-tool="eraser" title="橡皮">🧹</button>
    <button class="draw-tool" data-tool="hand" title="手型 · 拖动平移">✋</button>
    <span class="draw-sep"></span>
    <button class="draw-action draw-zoom-btn" id="drawZoomOut" title="缩小">−</button>
    <span class="draw-zoom" id="drawZoomLabel" aria-live="off">100%</span>
    <button class="draw-action draw-zoom-btn" id="drawZoomIn" title="放大">＋</button>
    <button class="draw-action" id="drawZoomReset" title="恢复 100%">复位</button>
    <span class="draw-sep"></span>
    <button class="draw-color active" data-color="#3c3a32" style="background:#3c3a32" title="深色"></button>
    <button class="draw-color" data-color="#b45309" style="background:#b45309" title="棕色"></button>
    <button class="draw-color" data-color="#2563eb" style="background:#2563eb" title="蓝色"></button>
    <button class="draw-color" data-color="#dc2626" style="background:#dc2626" title="红色"></button>
    <button class="draw-color" data-color="#16a34a" style="background:#16a34a" title="绿色"></button>
    <span class="draw-sep"></span>
    <button class="draw-action" id="drawClear" title="清空画布">🗑️</button>
    <button class="draw-action" id="drawUndo" title="撤销">↶</button>
    <span class="grow"></span>
    <button class="draw-action" id="drawBack" title="返回文字">✎ 文字</button>
  </div>
</div>
<section class="console folded" id="consolePanel"><button class="consolehead" id="foldConsole" aria-expanded="false" aria-controls="consoleBody" title="展开或收起终端"><span class="ctitle">终端</span><span id="runState">就绪</span><span class="chev">⌃</span></button><div class="consolebody" id="consoleBody"><div class="consolebar"><button id="outputTab" class="active">输出</button><button id="inputTab">输入</button><span class="grow"></span><button id="clearOutput">清空</button></div><pre id="output" role="log" aria-live="polite"><span class="dim">Python 已内置。写好代码后点“运行”。
需要 input() 时，先切到“输入”填写内容。</span></pre><textarea id="stdin" hidden aria-label="标准输入" placeholder="运行前填写，每个 input() 一行。未提供的输入返回 EOF。" spellcheck="false"></textarea></div></section>
</main>
<aside id="lectureTimeline" aria-label="时间轴与锚点"><canvas id="timelineCanvas" aria-label="录音波形时间轴"></canvas><div class="tl-controls"><button id="zoomOut" aria-label="缩小时间轴" title="缩小">－</button><button id="zoomIn" aria-label="放大时间轴" title="放大">＋</button><span id="tlRange">全程</span></div><div id="anchorList" aria-label="锚点列表"></div></aside>
<aside id="lectureSlides" aria-label="PPT 照片"><div id="slideList" aria-label="PPT 照片列表"></div><button id="importSlide">＋ 导入 PPT 照片</button><button id="importPptx">📄 导入 PPT 文件</button>
<div class="demoire-row"><label><input type="checkbox" id="demoireEnabled" checked> 拍后去摩尔纹</label><div class="demoire-slider"><input type="range" id="demoireStrength" min="0" max="100" value="60" aria-label="去摩尔纹强度"><output id="demoireValue">60%</output></div><p>拍屏幕/投影时手机稍微倾斜 2–5°，波纹会更少。处理只压色度，文字不糊；对新导入的照片生效。</p></div></aside>
</section>
<div id="lectureTabs" role="tablist" aria-label="上课面板切换"><button class="lecture-tab active" data-tab="notes" role="tab" aria-selected="true">笔记</button><button class="lecture-tab" data-tab="timeline" role="tab" aria-selected="false">时间轴</button><button class="lecture-tab" data-tab="slides" role="tab" aria-selected="false">PPT</button></div>
<div class="quickkeys" aria-label="编程快捷输入"><button data-key="tab">Tab</button><button data-key="undo" aria-label="撤销">↶</button><button data-key="redo" aria-label="重做">↷</button><button data-insert="(" data-pair=")">( )</button><button data-insert="[" data-pair="]">[ ]</button><button data-insert="{" data-pair="}">{ }</button><button data-insert=":">:</button><button data-insert="=">=</button><button data-insert="'">'</button><button data-insert="&quot;">"</button><button data-insert=",">,</button><button data-insert=".">.</button><button data-insert="#">#</button><button data-insert="    " aria-label="四空格缩进">␣␣</button><button data-key="left" aria-label="左移">←</button><button data-key="right" aria-label="右移">→</button><button data-key="newline" aria-label="换行">↵</button></div>
<footer class="statusbar"><span id="saveState">草稿已保存</span><span id="position">第 1 行，第 1 列</span><span id="noteCount"></span><span class="grow"></span><span id="language">Python</span><span id="encoding">UTF-8</span></footer>
<section id="lounge" hidden><div class="loungehead"><button id="codeTab">← 返回编辑器</button></div><article class="gamecard"><div class="gameart"><img src="../studio-game.png" alt="星火远征像素游戏场景"><span class="gamebadge">离线单机 · 进度保留</span></div><div class="gameinfo"><small>伍子平 · 星火远征</small><h2>从中山大学出发</h2><p>走进体内八境，或去数学星庭走一回机关。原来的游戏存档还在。</p><button id="playGame" class="primary playcta">进入游戏</button><p class="savehint" id="gameSaveInfo">进度自动保存。游戏里按返回键可回到这里。</p></div></article><div class="backuprow"><button id="exportGame">备份存档</button><button id="importGame">导入存档</button></div></section>

<section id="aiPanel" hidden aria-label="AI 助手">
<aside class="ai-side">
 <div class="ai-section"><h3 id="aiSettingsTitle">连接与外观</h3>
  <label class="ai-field"><input id="aiEnabled" type="checkbox"><span id="aiEnableLabel">开启联网</span></label>
  <label class="ai-field">接口地址<input id="aiBaseUrl" type="url" autocomplete="off" spellcheck="false"></label>
  <label class="ai-field">API Key<input id="aiApiKey" type="password" autocomplete="off"></label>
  <label class="ai-field">模型<input id="aiModel" list="aiModels" autocomplete="off"><datalist id="aiModels"><option value="deepseek-chat"><option value="deepseek-reasoner"><option value="deepseek-coder"></datalist></label>
  <label class="ai-field">温度<input id="aiTemperature" type="number" min="0" max="2" step="0.1"></label>
  <label class="ai-field"><input id="aiRemote" type="checkbox"><span>连接电脑上的服务</span></label>
  <label class="ai-field">电脑服务地址<input id="aiRemoteUrl" type="url" autocomplete="off" spellcheck="false" placeholder="http://192.168.1.10:8080/v1/chat/completions"></label>
  <label class="ai-field"><input id="aiAutoApprove" type="checkbox"><span>自动批准只读工具</span></label>
  <label class="ai-field"><input id="aiAgentLoop" type="checkbox" checked><span>多步执行（看完结果再继续）</span></label>
  <label class="ai-field">系统提示<textarea id="aiSystem"></textarea></label>
 </div>
 <div class="ai-section"><h3 id="aiQuickTitle">快捷指令</h3><div class="ai-quick" id="aiQuick">
  <button data-quick="explain" type="button">解释当前代码</button><button data-quick="generate" type="button">生成代码</button>
  <button data-quick="run" type="button">运行当前文件</button><button data-quick="summarize" type="button">总结会话</button>
  <button data-quick="phone" type="button">看看手机状态</button>
 </div></div>
</aside>
<div class="ai-main">
 <header class="ai-head"><button id="aiHome" type="button">首页</button><h2 id="aiTitle">AI 助手</h2><span class="ai-status" id="aiStatus">联网未开启</span><span class="grow"></span>
  <select id="aiLang" aria-label="语言"><option value="zh">中文</option><option value="en">English</option></select>
  <select id="aiTheme" aria-label="主题"><option value="jade">青绿</option><option value="ink">墨蓝</option><option value="amber">琥珀</option><option value="rose">胭脂</option><option value="ocean">湖蓝</option><option value="violet">紫藤</option></select>
  <select id="aiView" aria-label="视图"><option value="chat">对话</option><option value="web">网页</option></select>
  <button id="aiNewSession" type="button">新会话</button><button id="aiExport" type="button">导出会话</button>
  <button id="aiImport" type="button">导入回放</button><button id="aiShare" type="button">分享卡</button>
 </header>
 <div class="ai-gate" id="aiGate"><p id="aiGateText">AI 助手默认不联网。开启后，请求只发往你填写的服务，密钥仅保存在本机工作区。</p><button id="aiGateBtn" type="button">我了解，开启联网</button></div>
 <p class="ai-status-hint" id="aiStatusHint">打开其他应用、分享、短信草稿、剪贴板和写文件之前，需要你点「允许」。</p>
 <div class="ai-messages" id="aiMessages" role="log" aria-live="polite"></div>
 <div class="ai-queue" id="aiQueue" hidden><strong id="aiQueueLabel">插话队列</strong><ul id="aiQueueList"></ul><button id="aiFlushQueue" type="button">立即发送</button></div>
 <form class="ai-composer" id="aiComposer">
  <textarea id="aiInput" placeholder="问点什么，或让我帮你改代码…"></textarea>
  <button id="aiAttach" type="button">添加图片</button><input id="aiAttachInput" type="file" accept="image/*" hidden>
  <button id="aiVoice" type="button">语音输入</button>
  <button class="ai-send" id="aiSend" type="submit">发送</button><button id="aiStop" type="button">停止</button>
 </form>
</div>
<aside class="ai-tools">
 <div class="ai-pet" id="aiPet" data-state="off"><div class="head"></div><div class="body"></div></div>
 <div class="ai-pet-note" id="aiPetNote">小助手</div>
 <div class="ai-section"><h3 id="aiToolsTitle">工具卡</h3><button id="aiAuthorize" type="button">授权手机目录</button><p class="ai-status-hint">写文件、删除、打开网页或其他应用、拨号、短信草稿、分享、剪贴板和已安装应用列表都会先生成卡片。只读的设备状态可以自动批准。多步任务每次结果回来后继续，点「停止」可中断。短信不会自动发送。</p></div>
</aside>
</section>
<dialog id="aiShareDialog" class="ai-dialog"><h2 id="aiShareTitle">天工 · AI 助手对话</h2><canvas id="aiShareCanvas" width="720" height="520"></canvas><div class="ai-dialog-actions"><button id="aiCloseShare" type="button">关闭</button></div></dialog>
<dialog id="aiSessionDialog" class="ai-dialog"><h2 id="aiSessionTitle">会话回放</h2><textarea id="aiSessionText" spellcheck="false"></textarea><div class="ai-dialog-actions"><button id="aiCopy" type="button">复制会话</button><button id="aiLoad" type="button">载入会话文本</button><button id="aiCloseSession" type="button">关闭</button></div></dialog>
<div id="toast" role="status" hidden></div>
<dialog id="anchorDialog"><form method="dialog"><span class="eyebrow">锚点</span><h2>编辑锚点</h2><label for="anchorLabel">标签</label><input id="anchorLabel" autocomplete="off" maxlength="40" placeholder="例如：讲到第 3 页"><label for="anchorTime">时间（秒，可写 1:23）</label><input id="anchorTime" inputmode="decimal" autocomplete="off" placeholder="0.0"><p class="hint" id="anchorSlide">未关联 PPT 照片。</p><div class="dialogactions"><button id="anchorDelete" value="delete">删除</button><button value="cancel">取消</button><button id="anchorSave" value="save" class="primary">保存</button></div></form></dialog>
<dialog id="slideDialog"><form method="dialog"><span class="eyebrow">PPT</span><h2 id="slideTitle">照片预览</h2><img id="slideImage" alt="PPT 照片预览"><div class="dialogactions"><button id="slideToggleRaw" type="button" hidden>对比原图</button><button value="cancel">关闭</button><button id="slideSeek" value="seek" class="primary">跳到此页开始</button></div></form></dialog>
<dialog id="menuDialog" class="menu"><div class="menutitle">操作</div><div class="menugrid"><button id="menuMode">回到首页</button><button id="menuNew">新建文件</button><button id="menuOpen">打开文件</button><button id="menuFolder">导入文件夹</button><button id="menuSave">保存</button><button id="exportButton">另存为…</button><button id="findButton">查找替换</button><button id="settingsButton">编辑器设置</button><button id="menuGame">进入游戏</button></div><form method="dialog"><button class="menuclose">关闭</button></form></dialog>
<dialog id="nameDialog"><form method="dialog"><span class="eyebrow">文件</span><h2 id="nameTitle">新建文件</h2><label for="fileName">文件路径</label><input id="fileName" autocomplete="off" spellcheck="false" placeholder="例如 utils/helper.py"><p class="hint" id="nameHint">可带子文件夹；请写扩展名，例如 .py。</p><div class="dialogactions"><button value="cancel">取消</button><button id="confirmName" value="default" class="primary">创建</button></div></form></dialog>
<dialog id="settingsDialog"><form method="dialog"><span class="eyebrow">编辑器</span><h2>设置</h2><div class="setrow"><label for="fontSize">字号</label><input id="fontSize" type="range" min="12" max="24" value="15"><output id="fontSizeValue">15</output></div><label class="check"><input id="wordWrap" type="checkbox"> 长行自动换行</label><div class="setrow"><label for="timeLimit">运行上限</label><select id="timeLimit"><option value="15">15 秒</option><option value="30">30 秒</option><option value="60">60 秒</option></select></div><p class="hint">Python 在手机本地离线运行，支持常用标准库。C/C++、Java 可编辑，暂不编译。</p><div class="dialogactions"><button class="primary">完成</button></div></form></dialog>
<input id="browserFiles" type="file" multiple hidden><input id="browserFolder" type="file" multiple webkitdirectory hidden><input id="slideInput" type="file" accept="image/*" multiple hidden><input id="pptxInput" type="file" accept=".pptx,.ppt,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-powerpoint" hidden>
<script src="boot.js"></script><script src="app.js"></script></body></html>
