<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content"><meta name="theme-color" content="#ffffff"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232563eb'/%3E%3Cpath d='M8 23V9h4v5.4L17.2 9h5.2l-5.8 6.1L23 23h-5.2l-3.7-5.4L12 19.4V23z' fill='white'/%3E%3C/svg%3E"><meta http-equiv="Content-Security-Policy" content="default-src 'self' data: blob:; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'"><title>天工</title><link rel="stylesheet" href="style.css"><link rel="stylesheet" href="lecture.css"><link rel="stylesheet" href="tts.css"><link rel="stylesheet" href="ai.css"><link rel="stylesheet" href="model.css"><link rel="stylesheet" href="shell.css"><link rel="stylesheet" href="theme.css"><link rel="stylesheet" href="fx.css"><link rel="stylesheet" href="cockpit.css"><link rel="stylesheet" href="workspace.css"><link rel="stylesheet" href="workspace-wheel.css"><link rel="stylesheet" href="python-lab-panel.css"><link rel="stylesheet" href="tabs.css"><script src="theme-boot.js"></script></head>
<body>
<section id="landing" aria-label="天工首页" data-ready="0" data-surface="desk">
<div id="workspaceDesk">
 <header class="workspace-bar">
  <button id="catalogHome" class="homeback" type="button" aria-label="返回工作区" title="返回工作区" hidden><span class="homeback-chev" aria-hidden="true"></span></button>
  <h1 id="workspaceTitle">学习</h1>
  <button id="deskSettings" type="button" aria-haspopup="dialog" aria-controls="settingsDialog" disabled>设置</button>
 </header>
 <div class="workspace-pages" id="workspacePages">
  <section class="workspace-page" id="studyDesk" role="tabpanel" aria-labelledby="deskStudy">
   <div class="desk-body" id="deskBody" aria-busy="true"><p>正在读取工作区…</p></div>
  </section>
  <section class="workspace-page" id="codeDesk" role="tabpanel" aria-labelledby="deskCode" aria-hidden="true" inert>
   <div class="desk-body" id="codeBody" aria-busy="true"><p>正在读取工作区…</p></div>
  </section>
  <section class="workspace-page catalog-scroll" id="toolCatalog" role="tabpanel" aria-labelledby="deskCatalog" aria-hidden="true" inert>
 <section class="catalog-group" data-group="study" aria-label="学习">
  <h2>学习</h2>
  <div class="catalog-grid">
   <button class="home-card" type="button" data-mode="overview" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">📊</span><span class="catalog-copy"><strong>学习总览</strong><small>今日安排与复习进度</small></span></button>
   <button class="home-card" type="button" data-mode="lecture" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">🎙</span><span class="catalog-copy"><strong>上课</strong><small>录音、笔记和 PPT</small></span></button>
   <button class="home-card" type="button" data-mode="focus" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">🍅</span><span class="catalog-copy"><strong>专注番茄</strong><small>专注计时与休息</small></span></button>
   <button class="home-card" type="button" data-mode="cards" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">🗂</span><span class="catalog-copy"><strong>记忆卡片</strong><small>按到期时间复习</small></span></button>
   <button class="home-card" type="button" data-mode="mistakes" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">📕</span><span class="catalog-copy"><strong>错题本</strong><small>整理错题，生成复习卡</small></span></button>
   <button class="home-card" type="button" data-mode="habits" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">✅</span><span class="catalog-copy"><strong>习惯打卡</strong><small>记录每天完成的习惯</small></span></button>
   <button class="home-card" type="button" data-mode="schedule" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">📅</span><span class="catalog-copy"><strong>课程表</strong><small>查看课程和上课地点</small></span></button>
   <button class="home-card" type="button" data-mode="medquiz" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">🩺</span><span class="catalog-copy"><strong>医学生刷题</strong><small>基础医学 8 科，答完看解析</small></span></button>
   <button class="home-card" type="button" data-mode="exams" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">⏳</span><span class="catalog-copy"><strong>任务 DDL</strong><small>跟踪作业和考试时间</small></span></button>
  </div>
 </section>
 <section class="catalog-group" data-group="create" aria-label="创作">
  <h2>创作</h2>
  <div class="catalog-grid">
   <button class="home-card" type="button" data-mode="python" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">&lt;/&gt;</span><span class="catalog-copy"><strong>写代码</strong><small>Python、C++ 和网页</small></span></button>
   <button class="home-card" type="button" data-mode="notepad" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">✎</span><span class="catalog-copy"><strong>记事本</strong><small>编辑和保存笔记</small></span></button>
   <button class="home-card" type="button" data-mode="photo" data-kind="native" disabled><span class="catalog-icon" aria-hidden="true">◐</span><span class="catalog-copy"><strong>修图</strong><small>调色、裁剪、拼图、加水印</small></span></button>
   <button class="home-card" type="button" data-mode="model" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">◈</span><span class="catalog-copy"><strong>3D 建模</strong><small>手机建模，导出 OBJ / GLB</small></span></button>
  </div>
 </section>
 <section class="catalog-group" data-group="kit" aria-label="Kit 工具箱">
  <h2>Kit 工具箱</h2>
  <div class="catalog-grid">
   <button class="home-card" type="button" data-mode="medcalc" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">🧮</span><span class="catalog-copy"><strong>临床计算</strong><small>BMI、肌酐清除率和滴速</small></span></button>
   <button class="home-card" type="button" data-mode="tts" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">EN</span><span class="catalog-copy"><strong>英文朗读</strong><small>按句子朗读英文，可调语速</small></span></button>
   <button class="home-card" type="button" data-mode="scan" data-kind="native" disabled><span class="catalog-icon" aria-hidden="true">▣</span><span class="catalog-copy"><strong>扫描文档</strong><small>拍书页和讲义，自动裁边，导出 PDF</small></span></button>
  </div>
 </section>
 <section class="catalog-group" data-group="more" aria-label="助手">
  <h2>助手</h2>
  <div class="catalog-grid">
   <button class="home-card" type="button" data-mode="ai" data-kind="web" disabled><span class="catalog-icon" aria-hidden="true">✧</span><span class="catalog-copy"><strong>AI 助手</strong><small>使用已配置的 AI 接口</small></span></button>
  </div>
 </section>
  </section>
 </div>
 <nav class="workspace-nav" aria-label="工作区导航">
  <div class="workspace-tabs" id="workspaceTabs" role="tablist" aria-label="工作区">
   <button id="deskStudy" type="button" role="tab" aria-controls="studyDesk" aria-selected="true" data-page="study" disabled><span class="nav-symbol" aria-hidden="true">◫</span>学习</button>
   <button id="deskCode" type="button" role="tab" aria-controls="codeDesk" aria-selected="false" data-page="code" tabindex="-1" disabled><span class="nav-symbol nav-code" aria-hidden="true">&lt;/&gt;</span>编程</button>
   <button id="deskCatalog" type="button" role="tab" aria-controls="toolCatalog" aria-selected="false" data-page="catalog" tabindex="-1" disabled><span class="nav-symbol" aria-hidden="true">▦</span>工具</button>
  </div>
  <button id="deskWheel" type="button" aria-haspopup="dialog" aria-controls="workspaceWheel" disabled><span class="wheel-icon" aria-hidden="true"></span>转盘</button>
 </nav>
</div>
</section>
<section id="recentRoot" class="studio-tab-root" aria-label="最近" hidden>
 <header class="studio-tab-head">
  <div><span class="studio-kicker">材料与记录</span><h1>最近</h1><p id="recentOverview">打开、保存和导入的材料会出现在这里</p></div>
 </header>
 <div class="studio-segment" id="recentModes" role="tablist" aria-label="最近分组方式">
  <button type="button" role="tab" data-recent-mode="time" aria-selected="true">按时间</button>
  <button type="button" role="tab" data-recent-mode="source" aria-selected="false">按来源</button>
  <button type="button" role="tab" data-recent-mode="format" aria-selected="false">按格式</button>
 </div>
 <label class="recent-search"><span class="sr-only">搜索最近</span><input id="recentSearch" type="search" autocomplete="off" placeholder="搜索标题、路径…" aria-label="搜索最近记录"></label>
 <div id="recentList" class="recent-list" aria-live="polite"></div>
</section>
<section id="profileRoot" class="studio-tab-root" aria-label="我的" hidden>
 <header class="studio-tab-head">
  <div><span class="studio-kicker">本机资料</span><h1>我的</h1><p>学习数据、偏好与隐私都留在这台设备</p></div>
 </header>
 <div class="profile-summary">
  <div><b id="profileStreak">0</b><span>连续天数</span></div>
  <div><b id="profileFocus">0</b><span>本周专注</span></div>
  <div><b id="profileCards">0</b><span>记忆卡片</span></div>
  <div><b id="profileMistakes">0</b><span>错题</span></div>
 </div>
 <nav class="profile-groups" aria-label="设置分组">
  <button type="button" data-profile-action="appearance"><span><strong>外观与主题</strong><small>深色、主题色、字号与动效</small></span><i>›</i></button>
  <button type="button" data-profile-action="home"><span><strong>首页设置</strong><small>课程表、周末、晚间与 AI 悬浮条</small></span><i>›</i></button>
  <button type="button" data-profile-action="study"><span><strong>学习设置</strong><small>课程表、提醒、刷题与卡片上限</small></span><i>›</i></button>
  <button type="button" data-profile-action="privacy"><span><strong>数据与隐私</strong><small>备份、最近保留、缓存与 AI 数据</small></span><i>›</i></button>
  <button type="button" data-profile-action="about"><span><strong>关于天工</strong><small>版本、开源说明与本机存储</small></span><i>›</i></button>
 </nav>
 <p class="profile-note">AI 学习摘要、复习包与完整复习闭环将在后续阶段开放；当前入口会明确标注，不把未完成功能伪装成可用。</p>
</section>
<nav id="studioTabbar" class="studio-tabbar" role="tablist" aria-label="主导航">
 <button type="button" role="tab" aria-controls="recentRoot" data-studio-tab="recent" aria-selected="false" tabindex="-1"><span aria-hidden="true">◷</span><small>最近</small></button>
 <button type="button" role="tab" aria-controls="landing" data-studio-tab="home" aria-selected="true"><span aria-hidden="true">⌂</span><small>首页</small></button>
 <button type="button" role="tab" aria-controls="profileRoot" data-studio-tab="profile" aria-selected="false" tabindex="-1"><span aria-hidden="true">◎</span><small>我的</small></button>
</nav>
<button id="aiEdgeHandle" class="ai-edge-handle" type="button" aria-label="打开 AI 助手；向上拖动可调整位置，向左拖动 72 像素松手打开" title="AI 助手"><span aria-hidden="true">✦</span><small>AI</small></button>
<span id="aiHandleHint" class="ai-handle-hint" role="status" hidden>松开进入 AI</span>
<header class="appbar"><button id="homeButton" class="homeback" type="button" aria-label="返回工作区" title="返回工作区"><span class="homeback-chev" aria-hidden="true"></span></button><button id="deskSwitch" class="desk-switch" type="button">切换工作区</button><button id="filesToggle" class="icon" aria-label="文件列表" title="文件列表">☰</button><div class="doc"><strong id="activePath">main.py</strong><small id="dirtyFlag">本地草稿</small></div><button id="drawToggle" class="icon drawtoggle" aria-label="画画" title="画画" aria-pressed="false" hidden>🖌️</button><button id="mdToggle" class="icon mdtoggle" aria-label="Markdown 预览" title="Markdown 预览" aria-pressed="false" hidden>👁</button><button id="saveButton" class="icon saveicon" aria-label="保存" title="保存">保存</button><button id="runButton" class="primary">▶ 运行</button><button id="stopButton" class="danger" hidden>■ 停止</button><button id="moreButton" class="icon" aria-label="更多操作" title="更多操作">⋯</button></header>
<section id="lectureBar" aria-label="上课录音控制" data-state="idle"><span class="recdot" aria-hidden="true"></span><button id="recordBtn" data-role="rec"><span id="recordLabel">🎙 开始录音</span></button><button id="pauseBtn" class="recalt" hidden>⏸ 暂停</button><button id="stopBtn" class="recstop" hidden>⏹ 停止</button><button id="newRecBtn" class="recalt" hidden>🎙 新录音</button><strong id="recordTimer">00:00</strong><label class="rec-translate" id="translateToggle"><input type="checkbox" id="translateCheck"><span class="reccheck"></span><span class="reclabel">翻译</span></label><span class="grow"></span><button id="anchorBtn" class="recanchor" hidden>📌<span class="anchorbtntext"> 标记锚点</span></button></section>
<section id="ttsBar" aria-label="英文朗读控制" data-state="idle">
<div class="tts-main"><span class="tts-mark" aria-hidden="true">EN</span><div class="tts-summary"><strong>英文朗读</strong><small id="ttsMeta" aria-live="off">在编辑器里输入或打开英文文本</small></div><button id="ttsPlay" class="tts-play" aria-label="开始英语朗读"><span id="ttsPlayText">朗读</span></button><button id="ttsStop" class="tts-stop" aria-label="停止英语朗读" title="停止">■</button></div>
<div class="tts-options"><label class="tts-field"><span>语音</span><select id="ttsVoice" aria-label="英语语音"><option value="">系统默认 · English</option></select></label><label class="tts-field tts-rate-field"><span>语速</span><input id="ttsRate" type="range" min="0.75" max="1.5" step="0.05" value="1" aria-label="英语朗读语速"><output id="ttsRateValue">1x</output></label><label class="tts-field tts-check"><input id="ttsHighlight" type="checkbox" checked aria-label="朗读时高亮当前句"><span>高亮</span></label><label class="tts-field tts-check"><input id="ttsAutoscroll" type="checkbox" aria-label="跟随朗读自动滚动"><span>滚动</span></label><span id="ttsStatus" role="status">正在准备英语语音…</span><div class="tts-progress" role="progressbar" aria-live="off" aria-label="朗读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="ttsProgressFill"></span></div></div>
</section>
<p id="lectureHint" class="lecturehint" role="status" hidden></p>
<section id="workbench">
<div id="backdrop" hidden></div><aside id="explorer" aria-label="工作区文件"><div class="sheethead"><strong>文件</strong><button id="closeExplorer" class="icon" aria-label="关闭文件列表">✕</button></div><div class="fileactions"><button id="openFile">打开文件</button><button id="openFolder">导入文件夹</button></div><div id="fileList"></div><div class="explorerfoot">编辑自动保存草稿<br>“保存”写回手机原文件</div><div class="sheetfoot"><button id="newFile" class="newfile">＋ 新建文件</button></div></aside>
<main class="workspace"><section id="pythonLabPanel" aria-label="Python 实验册" hidden></section><div id="editor" aria-label="代码编辑器"><div id="noteEmpty" aria-hidden="true">从这里开始写点什么…</div></div>
<div id="mdPreview" class="md-preview" hidden aria-label="Markdown 预览"></div>
<div id="drawLayer" hidden>
  <canvas id="drawCanvas" aria-label="画画画布"></canvas>
  <p id="drawHint">画画模式 · 手指涂写，双指捏合或滚轮缩放</p>
  <div id="drawToolbar">
    <button class="draw-tool active" data-tool="pen" title="画笔">✏️</button>
    <button class="draw-tool" data-tool="eraser" title="橡皮">🧹</button>
    <button class="draw-tool" data-tool="hand" title="手型 · 拖动平移">✋</button>
    <span class="draw-sep"></span>
    <button class="draw-action draw-zoom-btn" id="drawZoomOut" title="缩小">−</button>
    <span class="draw-zoom" id="drawZoomLabel" aria-live="off">100%</span>
    <button class="draw-action draw-zoom-btn" id="drawZoomIn" title="放大">＋</button>
    <button class="draw-action" id="drawZoomReset" title="恢复 100%">复位</button>
    <span class="draw-sep"></span>
    <button class="draw-color active" data-color="#3c3a32" style="background:#3c3a32" title="深色"></button>
    <button class="draw-color" data-color="#b45309" style="background:#b45309" title="棕色"></button>
    <button class="draw-color" data-color="#2563eb" style="background:#2563eb" title="蓝色"></button>
    <button class="draw-color" data-color="#dc2626" style="background:#dc2626" title="红色"></button>
    <button class="draw-color" data-color="#16a34a" style="background:#16a34a" title="绿色"></button>
    <span class="draw-sep"></span>
    <button class="draw-action" id="drawClear" title="清空画布">🗑️</button>
    <button class="draw-action" id="drawUndo" title="撤销">↶</button>
    <span class="grow"></span>
    <button class="draw-action" id="drawBack" title="返回文字">✎ 文字</button>
  </div>
</div>
<section class="console folded" id="consolePanel"><button class="consolehead" id="foldConsole" aria-expanded="false" aria-controls="consoleBody" title="展开或收起终端"><span class="ctitle">终端</span><span id="runState">就绪</span><span class="chev">⌃</span></button><div class="consolebody" id="consoleBody"><div class="consolebar"><button id="outputTab" class="active">输出</button><button id="inputTab">输入</button><span class="grow"></span><button id="saveOutput">存输出</button><button id="clearOutput">清空</button></div><pre id="output" role="log" aria-live="polite"><span class="dim">写好代码点「运行」。Python、C++、JavaScript 都在本机跑，不联网。
程序要读输入时，先在「输入」页填好，一行一条。</span></pre><textarea id="stdin" hidden aria-label="标准输入" placeholder="运行前填写，每个 input() 一行。未提供的输入返回 EOF。" spellcheck="false"></textarea></div></section>
</main>
<aside id="lectureTimeline" aria-label="时间轴与锚点"><canvas id="timelineCanvas" aria-label="录音波形时间轴"></canvas><div class="tl-controls"><button id="zoomOut" aria-label="缩小时间轴" title="缩小">－</button><button id="zoomIn" aria-label="放大时间轴" title="放大">＋</button><button id="playRate" class="tl-rate" aria-label="播放倍速" title="播放倍速">1×</button><button id="linePlay" class="tl-line" aria-label="从本行播放 10 秒" title="从本行播放 10 秒">10s</button><span id="tlRange">全程</span></div><div id="anchorList" aria-label="锚点列表"></div></aside>
<aside id="lectureSlides" aria-label="PPT 照片"><div id="slideStage" hidden><img id="slideNow" alt="当前 PPT 页"><span id="slideNowLabel">第 1 页</span></div><div id="slideNav"><button id="slidePrev" aria-label="上一页" title="上一页">◀</button><span id="slidePos">0 / 0</span><button id="slideNext" aria-label="下一页" title="下一页（录音中翻页自动打点）">▶</button><button id="slideMark" title="给当前页打一个时间点">📌 打点</button></div><div id="slideList" aria-label="PPT 照片列表"></div><button id="importSlide">＋ 导入 PPT 照片</button><button id="importPptx">📄 导入 PPT 文件</button>
<div class="demoire-row"><label><input type="checkbox" id="demoireEnabled" checked> 拍后去摩尔纹</label><div class="demoire-slider"><input type="range" id="demoireStrength" min="0" max="100" value="60" aria-label="去摩尔纹强度"><output id="demoireValue">60%</output></div><p>拍屏幕/投影时手机稍微倾斜 2–5°，波纹会更少。主要处理彩色条纹；照片预览中可处理已有页面并对比原图，效果因图片而异。</p></div></aside>
</section>
<div id="lectureTabs" role="tablist" aria-label="上课面板切换"><button class="lecture-tab active" data-tab="notes" role="tab" aria-selected="true">笔记</button><button class="lecture-tab" data-tab="timeline" role="tab" aria-selected="false">时间轴</button><button class="lecture-tab" data-tab="slides" role="tab" aria-selected="false">PPT</button></div>
<div class="quickkeys" aria-label="编程快捷输入"><button data-key="tab">Tab</button><button data-key="undo" aria-label="撤销">↶</button><button data-key="redo" aria-label="重做">↷</button><button data-insert="(" data-pair=")">( )</button><button data-insert="[" data-pair="]">[ ]</button><button data-insert="{" data-pair="}">{ }</button><button data-insert=":">:</button><button data-insert="=">=</button><button data-insert="'">'</button><button data-insert="&quot;">"</button><button data-insert=",">,</button><button data-insert=".">.</button><button data-insert="#">#</button><button data-insert="    " aria-label="四空格缩进">␣␣</button><button data-key="left" aria-label="左移">←</button><button data-key="right" aria-label="右移">→</button><button data-key="newline" aria-label="换行">↵</button></div>
<footer class="statusbar"><span id="saveState">草稿已保存</span><span id="position">第 1 行，第 1 列</span><span id="noteCount"></span><span class="grow"></span><span id="language">Python</span><span id="encoding">UTF-8</span></footer>
